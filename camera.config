; Camera / RTSP connection settings -- edit this file to point the pipeline
; at a different camera, without touching live_face_pipeline.py or
; RTSP_correct.py.
;
; Both scripts read rtsp_url and latency_ms from here. The --rtsp_url /
; --latency CLI flags (or the RTSP_URL env var) still take priority if you
; pass them, so this file is just the default.

[camera]
; Full RTSP URL, including credentials:
;   rtsp://<username>:<url-encoded-password>@<ip>:<port>/<stream-path>
; Note: special characters in the password must be URL-encoded (e.g. '@' -> '%40').
rtsp_url = rtsp://admin:Digital%40123@192.168.96.83:554/live1.sdp

; rtspsrc jitterbuffer latency in milliseconds.
; Higher = smoother but more delayed video; lower = more responsive but choppier.
latency_ms = 200
